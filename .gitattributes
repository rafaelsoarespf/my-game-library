# Normalize line endings to LF
* text=auto eol=lf

# Windows scripts need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts need LF
*.sh text eol=lf

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary

# Fonts
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# Documents and archives
*.pdf binary
*.zip binary
*.gz binary

# Hide generated and third-party code from GitHub language stats
dist/** linguist-generated
vendor/** linguist-vendored